<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>FeatureFlag</PackageId>
        <Version>1.0.0</Version>
        <Authors>FeatureFlag</Authors>
        <Description>Read feature toggles from the FeatureFlags configuration section via IFeatureFlags.IsEnabled.</Description>
        <PackageTags>feature-flags;configuration</PackageTags>
        <PackageProjectUrl>https://github.com/sasamocic/FeatureFlag</PackageProjectUrl>
        <RepositoryUrl>https://github.com/sasamocic/FeatureFlag.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2"/>
    </ItemGroup>

</Project>
